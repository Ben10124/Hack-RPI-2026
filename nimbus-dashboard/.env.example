# Copy this file to .env and fill in what you need.
# Everything is optional: with nothing set, the server keeps data in memory.

# Web server port
PORT=3000

# MongoDB connection string (MongoDB Atlas or a local mongod).
# Leave empty to use the in-memory store (data is lost on restart).
MONGODB_URI=
MONGODB_DB=nimbus

# MQTT broker the Pi 4 controller, camera counter and UNO Q publish to.
# Example: mqtt://192.168.1.50:1883  (the Pi 4 running Mosquitto)
MQTT_URL=
# Optional topic prefix, e.g. "nimbus/" makes topics nimbus/room1/sensors
MQTT_PREFIX=

# Run an MQTT broker inside this server (port 1883) instead of Mosquitto.
# Devices then publish to this computer's IP address.
EMBEDDED_BROKER=0
EMBEDDED_BROKER_PORT=1883

# Simulate rooms so the dashboard works before the hardware does.
#   all            -> simulate every room in config/rooms.json
#   room2,room3    -> simulate only these (e.g. real room1 + simulated others)
#   (empty)        -> no simulation
SIMULATE=

# How often a snapshot of each room is stored for the charts (seconds)
READING_INTERVAL_SECONDS=10
