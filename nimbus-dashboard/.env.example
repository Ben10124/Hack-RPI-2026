# Copy this file to .env and fill in what you need.
# Everything is optional: with nothing set, the server keeps data in memory.

# Web server port
PORT=3000

# MongoDB connection string (MongoDB Atlas or a local mongod).
# Leave empty to use the in-memory store (data is lost on restart).
MONGODB_URI=
MONGODB_DB=nimbus

# MQTT broker the Pi 4 controller, camera counter and UNO Q publish to.
# Example: mqtt://192.168.1.50:1883  (the Pi 4 running Mosquitto)
MQTT_URL=
# Optional topic prefix, e.g. "aerolite/" makes topics aerolite/room1/sensors
MQTT_PREFIX=

# Run an MQTT broker inside this server (port 1883) instead of Mosquitto.
# Devices then publish to this computer's IP address.
EMBEDDED_BROKER=0
EMBEDDED_BROKER_PORT=1883

# Simulate rooms so the dashboard works before the hardware does.
#   all            -> simulate every room in config/rooms.json
#   room2,room3    -> simulate only these (e.g. real room1 + simulated others)
#   (empty)        -> no simulation
SIMULATE=

# How often a snapshot of each room is stored for the charts (seconds)
READING_INTERVAL_SECONDS=10

# Which rooms this server's controller decides fan + window for. It publishes
# <room>/cmd and <room>/heartbeat for the device that drives the fan and servo.
#   (empty)        -> every room in config/rooms.json that isn't simulated
#   room1          -> only these
#   none           -> no controller (an external one publishes <room>/cmd)
CONTROL=

# Where to get the rain forecast (Open-Meteo, no key needed).
# Defaults to RPI in Troy, NY.
WEATHER_LAT=42.7298
WEATHER_LON=-73.6789

# Demo setting: force the rain chance (percent) so the window stays closed.
# Can also be switched on and off from the room page. Leave empty normally.
FORCE_RAIN=
